<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- S3 notification machinery: exact alarms for the appointed times,
         re-armed on boot/time changes. No location permission, no network. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Optional: only if the user chooses "موقعي (نظام الموقع)" in the
         settings — the app works fully offline from the bundled city database. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- An alarm app is the legitimate use case for exact alarms (the adhan
         must not drift). USE_EXACT_ALARM (API 33+) is install-granted for alarm
         apps; the revocable SCHEDULE_EXACT_ALARM covers older releases. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.Miqat"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The lock-screen alarm: wakes the screen like an alarm clock. -->
        <activity
            android:name=".ui.AlarmActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Miqat" />

        <!-- Plays the adhan in the foreground so it is heard with the phone
             in a pocket. -->
        <service
            android:name=".core.AdhanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".core.CountdownService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <receiver
            android:name=".core.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.miqat.action.ALARM" />
            </intent-filter>
        </receiver>

        <!-- The home-screen widget: the next prayer over the day's horizon. -->
        <!-- The shared month card (the FileProvider grants read access for
             the share sheet only — nothing is written outside the cache). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".ui.widget.MiqatWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.miqat.action.WIDGET_STATE_CHANGED" />
                <action android:name="app.miqat.action.WIDGET_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/miqat_widget_info" />
        </receiver>

        <receiver
            android:name=".core.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
