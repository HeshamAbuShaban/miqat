<?xml version="1.0" encoding="utf-8"?>
<!-- The light widget is the app's paper card: cream surface, ink-hairline
     edge, the same 20dp corners as the hero and the dark widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/miqat_widget_light_background" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/miqat_widget_light_outline" />
</shape>
