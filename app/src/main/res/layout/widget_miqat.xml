<?xml version="1.0" encoding="utf-8"?>
<!-- The widget — ONE panel: the horizon, the next prayer, the countdown.
     The palette is fixed here (the widget has no theme of its own): the app's
     dark tokens — lapis night, gold, dim text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/widget_arc"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_prayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#E8C46A"
        android:textSize="16sp"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#EDEBE3"
        android:textSize="24sp"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#9AA0B8"
        android:textSize="11sp"
        android:includeFontPadding="false" />
</LinearLayout>
