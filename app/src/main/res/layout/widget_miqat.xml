<?xml version="1.0" encoding="utf-8"?>
<!-- THE FULL WIDGET — a full-bleed miniature of the app hero. The provider
     paints the whole card (sky, arc, ground, rounded corners) into widget_arc;
     the four lines below sit on the ground band. This file is the DARK default
     preview; the provider swaps the background and bitmap for the light theme.
     All colours are named tokens; RemoteViews owns the type, never the bitmap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/widget_arc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sky_preview"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:layoutDirection="rtl">

        <TextView
            android:id="@+id/widget_prayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/notokufiarabic_regular"
            android:textColor="@color/miqat_gold"
            android:textSize="20sp"
            android:text="@string/widget_sample_prayer"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/notokufiarabic_regular"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/miqat_text"
            android:textSize="28sp"
            android:text="@string/widget_sample_countdown"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_iqama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/ibmplexsansarabic_regular"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/miqat_teal"
            android:textSize="11sp"
            android:text="@string/widget_sample_iqama"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/notokufiarabic_regular"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/miqat_text_dim"
            android:textSize="12sp"
            android:text="@string/widget_sample_meta"
            android:maxLines="1"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
